---
import '../styles/tmux-theme.css';
import Layout from '../layouts/Layout.astro';
import TmuxStatusBar from '../components/TmuxStatusBar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import SkipToContent from '../components/SkipToContent.astro';
import OptimizedHead from '../components/OptimizedHead.astro';

// Fetch all posts for sidebar
const { getCollection } = await import('astro:content');
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5)
  .map(post => ({
    slug: post.slug,
    data: {
      title: post.data.title,
      pubDate: post.data.publishDate
    }
  }));

const projects = [
  {
    name: 'Nanobot',
    description: 'Python-based AI assistant for automation, file management, and workflow orchestration.',
    tech: ['Python', 'PM2', 'Node.js'],
    url: 'https://github.com/HKUDS/nanobot',
    stars: 986,
    status: 'active'
  },
  {
    name: 'GitHub Watcher',
    description: 'Nanobot skill for tracking GitHub repositories with releases, versions, and star counts.',
    tech: ['Python', 'gh CLI'],
    url: 'https://github.com/CCAgentOrg/nanobot-skills',
    stars: null,
    status: 'complete'
  },
  {
    name: 'YouTube Recommender',
    description: 'Dual-backend video recommendation system with duration filtering and engagement scoring.',
    tech: ['Python', 'YouTube API', 'Invidious'],
    url: 'https://github.com/CCAgentOrg/nanobot-skills',
    stars: null,
    status: 'complete'
  },
  {
    name: 'ProseRunner',
    description: 'Multi-agent workflow engine ported from OpenClaw Prose for parallel execution.',
    tech: ['Python', 'Markdown', 'Agent System'],
    url: 'https://github.com/CCAgentOrg/proserunner',
    stars: null,
    status: 'complete'
  },
  {
    name: 'DivyaPrabandham API',
    description: 'Learning website for 4000 Tamil pasurams with Next.js and TypeScript.',
    tech: ['Next.js', 'TypeScript', 'Tailwind'],
    url: 'https://github.com/CCAgentOrg/divyaprabandham-api',
    stars: null,
    status: 'in-progress'
  },
  {
    name: 'Lobster Python',
    description: 'Complete Python implementation of Lobster workflow runtime.',
    tech: ['Python', 'Workflow Engine'],
    url: 'https://github.com/CCAgentOrg/lobster-python',
    stars: null,
    status: 'complete'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <OptimizedHead
      title="Projects"
      description="Explore projects built with nanobot and creative coding experiments"
      image="https://nanobot.srik.me/og-image.svg"
      canonical={new URL('/projects', Astro.url)}
    />
  </head>
  <body>
    <SkipToContent />
    <TmuxStatusBar />
    <MobileDrawer />

    <div class="tmux-container">
      <div class="tmux-layout">
        <main class="tmux-main" id="main-content" role="main">
          <article class="tmux-window">
            <div class="tmux-window-header">
              <span class="tmux-window-title">projects.txt</span>
              <div class="tmux-window-controls">
                <span></span><span></span><span></span>
              </div>
            </div>

            <div class="tmux-window-body">
              <div class="projects-content">
                <h1>
                  <span class="typing-cursor">▊</span>
                  Projects
                </h1>

                <p class="lead">
                  A collection of experiments, tools, and creative coding projects.
                </p>

                <div class="tmux-prompt" style="margin: 2rem 0;">
                  <span class="tmux-prompt-symbol">$</span>
                  <span>ls -la ./projects</span>
                </div>

                <div class="projects-grid">
                  {projects.map((project) => (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-card"
                    >
                      <div class="project-header">
                        <h3>{project.name}</h3>
                        <span class={`project-status status-${project.status}`}>
                          {project.status === 'active' && '🟢'}
                          {project.status === 'complete' && '✅'}
                          {project.status === 'in-progress' && '🔨'}
                        </span>
                      </div>

                      <p>{project.description}</p>

                      <div class="project-tech">
                        {project.tech.map((tech) => (
                          <span class="tech-tag">{tech}</span>
                        ))}
                      </div>

                      {project.stars && (
                        <div class="project-stars">
                          ⭐ {project.stars.toLocaleString()} stars
                        </div>
                      )}

                      <div class="project-link">
                        View Project →
                      </div>
                    </a>
                  ))}
                </div>

                <div class="tmux-prompt" style="margin-top: 3rem;">
                  <span class="tmux-prompt-symbol">$</span>
                  <span class="typing-cursor">▊</span>
                </div>
              </div>
            </div>
          </article>
        </main>

        <aside class="tmux-sidebar">
          <ThemeToggle />
          <Sidebar />
        </aside>
      </div>
    </div>

    <style is:global>
      .projects-content {
        max-width: 1000px;
        margin: 0 auto;
      }

      .projects-content h1 {
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 2rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .lead {
        font-size: 1.25rem;
        color: var(--tmux-text-secondary);
        margin-bottom: 2rem;
      }

      .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .project-card {
        background-color: var(--tmux-bg-secondary);
        border: 1px solid var(--tmux-border-color);
        border-radius: 6px;
        padding: 1.5rem;
        text-decoration: none;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        overflow: hidden;
      }

      .project-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, var(--tmux-accent-primary), var(--tmux-accent-secondary));
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      .project-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--tmux-shadow-md);
        border-color: var(--tmux-accent-secondary);
      }

      .project-card:hover::before {
        opacity: 1;
      }

      .project-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .project-header h3 {
        margin: 0;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 1.1rem;
        color: var(--tmux-text-primary);
      }

      .project-status {
        font-size: 0.9rem;
      }

      .project-card p {
        color: var(--tmux-text-secondary);
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .tech-tag {
        background-color: var(--tmux-bg-tertiary);
        color: var(--tmux-accent-primary);
        padding: 0.25rem 0.6rem;
        border-radius: 3px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 0.75rem;
      }

      .project-stars {
        color: var(--tmux-text-muted);
        font-size: 0.85rem;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
      }

      .project-link {
        color: var(--tmux-accent-primary);
        font-weight: 600;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: auto;
      }

      .project-link:hover {
        color: var(--tmux-accent-secondary);
      }

      @media (max-width: 767px) {
        .projects-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <script src="/scripts/typing-effect.js"></script>
    <script src="/scripts/konami-code.js"></script>
    <script src="/scripts/human-typing.js"></script>
  </body>
</html>
