---
import Layout from '../layouts/Layout.astro';

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

// Posts are now fetched in Layout.astro and passed via Astro.locals
// For this page, we need to get them from the content collection
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  );
---

<Layout title="Home">
  <section>
    <h1>Experiments with nanobot</h1>
    <p>
      A blog documenting experiments, insights, and learnings from building
      and using nanobot — an AI assistant built with Python.
    </p>
  </section>

  <section>
    <h2>Blog Posts</h2>
    {posts.length === 0 ? (
      <p>No posts yet. Check back soon!</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>
              <h3>{post.data.title}</h3>
              <p class="description">{post.data.description}</p>
              <p class="date">{formatDate(post.data.publishDate)}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- JSON-LD Structured Data for SEO -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Nanobot Bytes",
    "description": "Projects and tools built with nanobot AI assistant",
    "url": "https://nanobot.srik.me",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://nanobot.srik.me/blog/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
</Layout>

<style>
  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  section {
    margin-bottom: 3rem;
  }

  h2 {
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 0.5rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    margin-bottom: 2rem;
  }

  .post-list a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-list a:hover h3 {
    color: #2563eb;
  }

  .post-list h3 {
    margin: 0 0 0.5rem 0;
  }

  .post-list .description {
    color: #555;
    margin: 0.5rem 0;
  }

  .post-list .date {
    color: #666;
    font-size: 0.9rem;
    margin: 0;
  }
</style>
