---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';

// Fetch and sort blog posts
const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const sortedPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
---

<Layout title="Blog" description="Recent articles and experiments from the nanobot-blog.">
  <header class="page-header">
    <h1>Blog</h1>
    <p class="subtitle">
      Recent articles, tutorials, and thoughts on AI, coding, and automation.
    </p>
  </header>

  <section class="post-list">
    {sortedPosts.map(post => (
      <PostCard post={post} />
    ))}
  </section>
</Layout>

<style>
  .page-header {
    padding: 2rem 0 3rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-accent);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 60ch;
    margin: 0 auto;
  }

  .post-list {
    display: grid;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 1rem 0 2rem;
      margin-bottom: 2rem;
    }

    .page-header h1 {
      font-size: 2.5rem;
    }

    .subtitle {
      font-size: 1.1rem;
    }
  }
</style>
