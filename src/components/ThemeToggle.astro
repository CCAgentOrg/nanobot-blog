---
/**
 * Theme Toggle Component
 * Switches between design themes (Normal/Tmux) and color modes (Light/Auto/Dark)
 */

const savedMode = 'light'; // Will be set by JavaScript
const savedTheme = 'default'; // Will be set by JavaScript
---

<div class="theme-toggle-container">
  <!-- Design Theme Buttons -->
  <div class="theme-group">
    <button
      id="btn-theme-normal"
      class="theme-btn design-theme-btn"
      data-theme="normal"
      onclick="setDesignTheme('normal')"
      aria-label="Normal design theme"
      title="Normal design theme"
    >
      Normal
    </button>
    <button
      id="btn-theme-tmux"
      class="theme-btn design-theme-btn"
      data-theme="tmux"
      onclick="setDesignTheme('tmux')"
      aria-label="Tmux design theme"
      title="Tmux design theme"
    >
      Tmux
    </button>
  </div>

  <!-- Color Mode Buttons -->
  <div class="theme-group">
    <button
      id="btn-mode-light"
      class="theme-btn color-mode-btn"
      data-mode="light"
      onclick="setColorMode('light')"
      aria-label="Light mode"
      title="Light mode"
    >
      ☀️ Light
    </button>
    <button
      id="btn-mode-system"
      class="theme-btn color-mode-btn"
      data-mode="system"
      onclick="setColorMode('system')"
      aria-label="System theme"
      title="Auto (system)"
    >
      🖥️ Auto
    </button>
    <button
      id="btn-mode-dark"
      class="theme-btn color-mode-btn"
      data-mode="dark"
      onclick="setColorMode('dark')"
      aria-label="Dark mode"
      title="Dark mode"
    >
      🌙 Dark
    </button>
  </div>
</div>

<style>
  .theme-toggle-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-group {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .theme-btn {
    background: transparent;
    border: 1px solid var(--tmux-accent-secondary);
    color: var(--tmux-status-text);
    padding: 0.4rem 0.6rem;
    border-radius: 3px;
    cursor: pointer;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 0.75rem;
    transition: all 0.2s ease;
  }

  .theme-btn:hover {
    background-color: var(--tmux-accent-secondary);
    color: var(--tmux-status-bg);
  }

  .theme-btn.active {
    background-color: var(--tmux-accent-secondary);
    color: var(--tmux-status-bg);
    border-color: var(--tmux-accent-secondary);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
  }
</style>

<script is:inline>
  // Theme management functions
  function setDesignTheme(theme) {
    localStorage.setItem('theme', theme);
    document.documentElement.setAttribute('data-theme', theme);

    // Get current mode for event dispatch
    const currentMode = document.documentElement.getAttribute('data-mode') || 'system';

    // Dispatch theme change event
    document.dispatchEvent(new CustomEvent('theme-change', {
      detail: { theme, mode: currentMode }
    }));

    // Update visual state
    document.querySelectorAll('.design-theme-btn').forEach(btn => {
      btn.classList.remove('active');
      if (btn.getAttribute('data-theme') === theme) {
        btn.classList.add('active');
      }
    });
  }

  function setColorMode(mode) {
    localStorage.setItem('mode', mode);

    if (mode === 'system') {
      localStorage.removeItem('mode');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-mode', systemDark ? 'dark' : 'light');
    } else {
      document.documentElement.setAttribute('data-mode', mode);
    }

    // Get current theme for event dispatch
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'normal';

    // Dispatch theme change event
    document.dispatchEvent(new CustomEvent('theme-change', {
      detail: { theme: currentTheme, mode }
    }));

    // Update visual state
    document.querySelectorAll('.color-mode-btn').forEach(btn => {
      btn.classList.remove('active');
      if (btn.getAttribute('data-mode') === mode) {
        btn.classList.add('active');
      }
    });
  }

  // Initialize theme on page load
  function initializeTheme() {
    // Initialize design theme (default to 'normal')
    const savedTheme = localStorage.getItem('theme') || 'normal';
    setDesignTheme(savedTheme);

    // Initialize color mode (default to 'system')
    const savedMode = localStorage.getItem('mode');
    if (savedMode) {
      setColorMode(savedMode);
    } else {
      setColorMode('system');
    }
  }

  // Run initialization when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTheme);
  } else {
    initializeTheme();
  }
</script>
