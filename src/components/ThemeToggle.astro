---
/**
 * Theme Toggle Component
 * Switches between dark and light modes
 */
---

<script src="/scripts/theme-toggle.ts"></script>

<div class="theme-toggle-container">
  <button
    class="theme-btn"
    data-theme="light"
    onclick="setTheme('light')"
    aria-label="Light mode"
    title="Light mode"
  >
    ☀️ Light
  </button>
  <button
    class="theme-btn"
    data-theme="system"
    onclick="setTheme('system')"
    aria-label="System theme"
    title="Auto (system)"
  >
    🖥️ Auto
  </button>
  <button
    class="theme-btn"
    data-theme="dark"
    onclick="setTheme('dark')"
    aria-label="Dark mode"
    title="Dark mode"
  >
    🌙 Dark
  </button>
</div>

<style>
  .theme-toggle-container {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .theme-btn {
    background: transparent;
    border: 1px solid var(--tmux-accent-secondary);
    color: var(--tmux-status-text);
    padding: 0.4rem 0.6rem;
    border-radius: 3px;
    cursor: pointer;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 0.75rem;
    transition: all 0.2s ease;
  }

  .theme-btn:hover {
    background-color: var(--tmux-accent-secondary);
    color: var(--tmux-status-bg);
  }

  .theme-btn.active {
    background-color: var(--tmux-accent-secondary);
    color: var(--tmux-status-bg);
    border-color: var(--tmux-accent-secondary);
  }
</style>
