---
// src/components/ThemeToggle.astro
---
<div class="theme-toggle-wrapper">
  <div class="theme-selector">
    <label for="theme-select">Theme:</label>
    <select id="theme-select">
      <option value="system">System</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </div>
  <div class="tmux-toggle">
    <label for="tmux-switch">TMUX Mode:</label>
    <label class="switch">
      <input type="checkbox" id="tmux-switch" />
      <span class="slider round"></span>
    </label>
  </div>
</div>

<script>
  const themeSelect = document.getElementById('theme-select');
  const tmuxSwitch = document.getElementById('tmux-switch');
  const docElement = document.documentElement;

  function applyTheme() {
    const selectedTheme = localStorage.getItem('theme') || 'system';
    const useTmux = localStorage.getItem('tmux') === 'true';

    themeSelect.value = selectedTheme;
    tmuxSwitch.checked = useTmux;

    docElement.classList.toggle('tmux-theme', useTmux);

    let themeToApply;
    if (selectedTheme === 'system') {
      themeToApply = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    } else {
      themeToApply = selectedTheme;
    }

    docElement.setAttribute('data-theme', themeToApply);
  }

  themeSelect.addEventListener('change', (e) => {
    localStorage.setItem('theme', e.target.value);
    applyTheme();
  });

  tmuxSwitch.addEventListener('change', (e) => {
    localStorage.setItem('tmux', e.target.checked);
    applyTheme();
  });

  // Apply theme on initial load
  document.addEventListener('astro:page-load', applyTheme);
  applyTheme(); // Also apply immediately on client

  // Listen for changes in system preference
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);
</script>

<style>
  .theme-toggle-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem;
    background-color: var(--color-background-secondary);
    border-radius: var(--border-radius-large);
    border: 1px solid var(--color-border);
  }

  .theme-selector, .tmux-toggle {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  label {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  select {
    font-family: inherit;
    font-size: 0.9rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--border-radius-small);
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-text);
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    padding-right: 2rem; /* space for arrow */
    background-image: var(--select-arrow);
    background-repeat: no-repeat;
    background-position: right 0.5rem center;
    background-size: 1rem;
  }

  /* The switch - the box around the slider */
  .switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }

  /* Hide default HTML checkbox */
  .switch input { 
    opacity: 0;
    width: 0;
    height: 0;
  }

  /* The slider */
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-background-tertiary);
    -webkit-transition: .4s;
    transition: .4s;
    border: 1px solid var(--color-border);
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background-color: var(--color-text-tertiary);
    -webkit-transition: .4s;
    transition: .4s;
  }

  input:checked + .slider {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  input:checked + .slider:before {
    background-color: white;
    -webkit-transform: translateX(20px);
    -ms-transform: translateX(20px);
    transform: translateX(20px);
  }

  /* Rounded sliders */
  .slider.round {
    border-radius: 34px;
  }

  .slider.round:before {
    border-radius: 50%;
  }
</style>
