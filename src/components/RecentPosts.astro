---
interface Props {
  posts: Array<{
    slug: string;
    data: {
      title: string;
      pubDate: Date;
    };
  }>;
}

const { posts } = Astro.props;
---

<div class="recent-posts">
  <h3 class="recent-posts-title">📌 Recent Posts</h3>
  {posts.length === 0 ? (
    <p class="no-posts">No posts yet.</p>
  ) : (
    <ul class="recent-posts-list">
      {posts.map((post) => (
        <li class="recent-posts-item">
          <a href={`/posts/${post.slug}/`} class="recent-posts-link">
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">
              {post.data.pubDate.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
              })}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .recent-posts {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 1.25rem;
  }

  .recent-posts-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
    color: #1a1a1a;
  }

  .recent-posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recent-posts-item {
    margin-bottom: 0.75rem;
  }

  .recent-posts-item:last-child {
    margin-bottom: 0;
  }

  .recent-posts-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #1a1a1a;
    transition: color 0.2s ease;
  }

  .recent-posts-link:hover {
    color: #2563eb;
  }

  .post-title {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .post-date {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.25rem;
  }

  .no-posts {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }
</style>
