---
import { getCollection } from 'astro:content';

/**
 * Recent Posts Widget (Terminal List Style)
 * Displays the 5 most recent blog posts
 */

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<div class="recent-posts-widget tmux-window">
  <div class="tmux-window-header">
    <div class="tmux-window-title">
      <span>📝 [Recent Posts]</span>
    </div>
    <div class="tmux-window-controls">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>

  <div class="tmux-window-body">
    <ul class="tmux-list">
      {recentPosts.map((post, index) => (
        <li>
          <span class="tmux-list-item-prefix">
            {index === 0 ? '├──' : '└──'}
          </span>
          <div class="tmux-list-item-content">
            <a href={`/blog/${post.slug}`} class="tmux-list-item-title">
              {post.data.title}
            </a>
            <div class="tmux-list-item-meta">
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              })}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .recent-posts-widget {
    width: 100%;
  }

  .tmux-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 0.85rem;
  }

  .tmux-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--tmux-border-color);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .tmux-list li:last-child {
    border-bottom: none;
  }

  .tmux-list-item-prefix {
    color: var(--tmux-accent-secondary);
    font-weight: bold;
    min-width: 2.5em;
    user-select: none;
  }

  .tmux-list-item-content {
    flex: 1;
  }

  .tmux-list-item-title {
    color: var(--tmux-accent-primary);
    display: block;
    margin-bottom: 0.25rem;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .tmux-list-item-title:hover {
    color: var(--tmux-accent-secondary);
    text-decoration: underline;
  }

  .tmux-list-item-meta {
    color: var(--tmux-text-muted);
    font-size: 0.8rem;
  }
</style>
