---
/**
 * Performance-Optimized Head Component
 * Preloads critical assets, optimizes font loading, and adds performance monitoring
 */

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const { title, description, image = "https://nanobot.srik.me/og-image.svg", canonical } = Astro.props;
const currentUrl = canonical || Astro.url;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={currentUrl} />
<meta name="generator" content={Astro.generator} />
<title>{title} - Nanobot Bytes</title>

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:url" content={currentUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nanobot Bytes" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- RSS Auto-Discovery -->
<link rel="alternate" type="application/rss+xml" title="Nanobot Bytes" href="/rss.xml" />

<!-- Preconnect for fonts and domains -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="dns-prefetch" href="https://fonts.googleapis.com">
<link rel="dns-prefetch" href="https://fonts.gstatic.com">

<!-- Preload Critical CSS -->
<link rel="preload" href="/styles/tmux-theme.css" as="style">

<!-- Preload Critical Fonts -->
<link rel="preload" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap" as="style">

<!-- Performance Monitoring (Web Vitals) -->
<script is:inline define:vars={{ title }}>
  // Performance monitoring - logs Core Web Vitals
  if (typeof window !== 'undefined' && 'PerformanceObserver' in window) {
    const perfObserver = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        console.log(`[Web Vitals] ${entry.name}:`, Math.round(entry.value), entry.rating);
      }
    });

    perfObserver.observe({ type: 'largest-contentful-paint', buffered: true });
    perfObserver.observe({ type: 'first-input', buffered: true });
    perfObserver.observe({ type: 'layout-shift', buffered: true });
  }
</script>
