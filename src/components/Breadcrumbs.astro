---
interface Props {
  currentTitle: string;
}

const { currentTitle } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="tmux-prompt breadcrumbs-prompt">
    <span class="tmux-prompt-symbol">$</span>
    <span class="breadcrumbs-path">
      <span class="breadcrumb-segment">
        <a href="/">home</a>
      </span>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-segment">
        <a href="/blog">blog</a>
      </span>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-segment breadcrumb-current">
        {currentTitle}
      </span>
    </span>
  </div>
</nav>

<!-- JSON-LD for Breadcrumbs -->
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://nanobot.srik.me/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://nanobot.srik.me/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": currentTitle,
      "item": Astro.url.href
    }
  ]
})} />

<style>
  .breadcrumbs {
    margin-bottom: 1rem;
  }

  .tmux-prompt {
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .tmux-prompt-symbol {
    color: var(--tmux-accent-success);
    font-weight: bold;
  }

  .breadcrumbs-path {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--tmux-text-secondary);
  }

  .breadcrumb-segment {
    color: var(--tmux-accent-primary);
  }

  .breadcrumb-segment a {
    color: var(--tmux-accent-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-segment a:hover {
    color: var(--tmux-accent-secondary);
    text-decoration: underline;
  }

  .breadcrumb-current {
    color: var(--tmux-text-primary);
    font-weight: 500;
  }

  .breadcrumb-separator {
    color: var(--tmux-text-muted);
  }

  /* Mobile optimization */
  @media (max-width: 767px) {
    .tmux-prompt {
      font-size: 0.75rem;
    }

    .breadcrumbs-path {
      flex-wrap: wrap;
    }
  }
</style>
