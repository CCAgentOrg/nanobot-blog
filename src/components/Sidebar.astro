---
import GLMWidget from './GLMWidget.astro';
import RecentPosts from './RecentPosts.astro';

/**
 * Sidebar Component
 * Contains GLM widget and recent posts list
 */
---

<aside class="sidebar">
  <div class="sidebar-section">
    <GLMWidget />
  </div>
  <div class="sidebar-section">
    <RecentPosts />
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-section {
    width: 100%;
  }

  /* Desktop: sidebar visible */
  @media (min-width: 768px) {
    .sidebar {
      display: flex;
    }
  }

  /* Mobile: sidebar handled by layout (stacks below content) */
  @media (max-width: 767px) {
    .sidebar {
      position: static;
    }
  }
</style>
