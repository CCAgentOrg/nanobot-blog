---
/**
 * Mobile Drawer Component
 * Slide-out sidebar for mobile devices with terminal styling
 */

import Sidebar from './Sidebar.astro';
---

<aside
  id="mobile-drawer"
  class="mobile-drawer"
  aria-label="Mobile navigation menu"
  aria-hidden="true"
  inert
>
  <div class="mobile-drawer-header">
    <h3>
      <span class="tmux-prompt-symbol">$</span> nanobytes
    </h3>
    <button
      id="mobile-drawer-close"
      class="mobile-drawer-close"
      aria-label="Close navigation menu"
      type="button"
    >
      ×
    </button>
  </div>

  <div class="mobile-drawer-section">
    <Sidebar />
  </div>
</aside>

<div
  id="mobile-drawer-overlay"
  class="mobile-drawer-overlay"
  aria-hidden="true"
></div>

<button
  id="mobile-menu-toggle"
  class="mobile-menu-toggle"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-drawer"
  type="button"
>
  <span class="sr-only">Menu</span>
  <span aria-hidden="true">☰</span>
</button>

<script is:inline>
  (function() {
    // Wait for DOM to be fully parsed
    function initMobileDrawer() {
      const drawer = document.getElementById('mobile-drawer');
      const drawerOverlay = document.getElementById('mobile-drawer-overlay');
      const menuToggle = document.getElementById('mobile-menu-toggle');
      const drawerClose = document.getElementById('mobile-drawer-close');

      // Early return if elements not found
      if (!drawer || !drawerOverlay || !menuToggle || !drawerClose) {
        console.error('[mobile-drawer] Elements not found:', {
          drawer: !!drawer,
          drawerOverlay: !!drawerOverlay,
          menuToggle: !!menuToggle,
          drawerClose: !!drawerClose
        });
        return;
      }

      function openDrawer() {
        if (!drawer || !drawerOverlay || !menuToggle || !drawerClose) return;
        drawer.classList.add('open');
        drawerOverlay.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        drawer.removeAttribute('inert');
        menuToggle.classList.add('active');
        menuToggle.textContent = '✕';
        menuToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        drawerClose.focus();
      }

      function closeDrawer() {
        if (!drawer || !drawerOverlay || !menuToggle) return;
        drawer.classList.remove('open');
        drawerOverlay.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.setAttribute('inert', '');
        menuToggle.classList.remove('active');
        menuToggle.textContent = '☰';
        menuToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        menuToggle.focus();
      }

      if (menuToggle) {
        menuToggle.addEventListener('click', () => {
          if (drawer?.classList.contains('open')) {
            closeDrawer();
          } else {
            openDrawer();
          }
        });
      }

      if (drawerClose) {
        drawerClose.addEventListener('click', closeDrawer);
      }

      if (drawerOverlay) {
        drawerOverlay.addEventListener('click', closeDrawer);
      }

      // Close drawer on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer?.classList.contains('open')) {
          closeDrawer();
        }
      });

      // Focus trap in drawer (for keyboard navigation)
      if (drawer) {
        drawer.addEventListener('keydown', (e) => {
          if (e.key === 'Tab') {
            const focusableElements = drawer.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];

            if (e.shiftKey && document.activeElement === firstElement) {
              e.preventDefault();
              lastElement?.focus();
            } else if (!e.shiftKey && document.activeElement === lastElement) {
              e.preventDefault();
              firstElement?.focus();
            }
          }
        });
      }

      console.log('[mobile-drawer] Initialized successfully');
    }

    // Run when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileDrawer);
    } else {
      initMobileDrawer();
    }
  })();
</script>

<style>
  .mobile-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--tmux-border-color);
    margin-bottom: 1.5rem;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  .mobile-drawer-header h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--tmux-accent-primary);
  }

  .mobile-drawer-close {
    background: transparent;
    border: none;
    color: var(--tmux-text-muted);
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .mobile-drawer-close:hover {
    color: var(--tmux-accent-danger);
  }

  .mobile-drawer-section {
    margin-bottom: 2rem;
  }
</style>
