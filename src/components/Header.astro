---
// src/components/Header.astro
const navLinks = [
  { href: "/", text: "Home" },
  { href: "/blog", text: "Blog" },
  { href: "/about", text: "About" },
];
---
<header class="site-header">
  <div class="header-container">
    <a href="/" class="logo">
      <span class="logo-accent">N</span>anobot <span class="logo-accent">B</span>ytes
    </a>
    <nav class="main-nav">
      <ul>
        {navLinks.map(link => (
          <li><a href={link.href}>{link.text}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
.site-header {
  background-color: var(--color-background-secondary);
  border-bottom: 1px solid var(--color-border);
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1400px;
  margin: 0 auto;
}

.logo {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-text-accent);
  text-decoration: none;
}

.logo-accent {
  color: var(--color-accent);
}

.main-nav ul {
  list-style: none;
  display: flex;
  gap: 1.5rem;
  margin: 0;
  padding: 0;
}

.main-nav a {
  font-size: 1rem;
  font-weight: 500;
  color: var(--color-text-secondary);
  text-decoration: none;
  transition: color 0.2s ease;
}

.main-nav a:hover {
  color: var(--color-accent);
}

@media (max-width: 768px) {
  .main-nav {
    display: none; /* Simple hiding for now, can be replaced with a mobile menu */
  }
}
</style>
