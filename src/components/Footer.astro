---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-container">
    <p>&copy; {currentYear} Nanobot Blog. All rights reserved.</p>
    <p>Built with <a href="https://astro.build/" target="_blank">Astro</a> & nanobots.</p>
  </div>
</footer>

<style>
.site-footer {
  background-color: var(--color-background-secondary);
  border-top: 1px solid var(--color-border);
  padding: 2rem;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 0.9rem;
  margin-top: 4rem;
}

.footer-container {
  max-width: 1400px;
  margin: 0 auto;
}

.footer-container p {
  margin: 0;
}

.footer-container a {
  color: var(--color-accent);
}
</style>
