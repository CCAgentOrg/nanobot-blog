---
/**
 * GLM Attribution Widget (Terminal Style)
 * Promotes z.ai GLM with referral link
 */

const referralLink = 'https://z.ai/subscribe?ic=5CA0GFZ4CO';
---

<div class="glm-widget tmux-window">
  <div class="tmux-window-header">
    <div class="tmux-window-title">
      <span>⚡ [z.ai GLM]</span>
    </div>
    <div class="tmux-window-controls">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>

  <div class="tmux-window-body">
    <div class="tmux-prompt">
      <span class="tmux-prompt-symbol">$</span>
      <span class="tmux-prompt-text">powered by GLM</span>
    </div>

    <div class="glm-cta">
      <a href={referralLink} class="tmux-button" target="_blank" rel="noopener noreferrer">
        → 10% Off GLM Plan
      </a>
    </div>
  </div>
</div>

<style>
  .glm-widget {
    width: 100%;
  }

  .tmux-window-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tmux-prompt {
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .tmux-prompt-symbol {
    color: var(--tmux-accent-success);
    font-weight: bold;
  }

  .tmux-prompt-text {
    color: var(--tmux-text-secondary);
  }

  .glm-cta {
    margin-top: 0.5rem;
  }

  .tmux-button {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, var(--tmux-accent-primary), var(--tmux-accent-secondary));
    color: #ffffff;
    padding: 0.75rem 1rem;
    border-radius: 4px;
    text-align: center;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
    box-shadow: var(--tmux-shadow-sm);
  }

  .tmux-button:hover {
    transform: translateY(-1px);
    box-shadow: var(--tmux-shadow-md);
    text-decoration: none;
    color: #ffffff;
  }

  .tmux-button:active {
    transform: translateY(0);
    box-shadow: var(--tmux-shadow-sm);
  }
</style>
