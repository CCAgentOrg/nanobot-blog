---
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  showSidebar?: boolean;
  description?: string;
  image?: string;
}

const { title, showSidebar = true, description = "Nanobot Bytes - Projects and tools built with nanobot AI assistant", image = "https://nanobot.srik.me/og-image.svg" } = Astro.props;

// Fetch all posts once (Astro best practice)
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5)
  .map(post => ({
    slug: post.slug,
    data: {
      title: post.data.title,
      pubDate: post.data.publishDate
    }
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Nanobot Bytes</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nanobot Bytes" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Nanobot Bytes</a>
        <a href="https://github.com/CCAgentOrg/nanobot-blog">GitHub</a>
      </nav>
    </header>
    <div class="container">
      <main>
        <slot />
      </main>
      {showSidebar && (
        <aside>
          <Sidebar recentPosts={recentPosts} />
        </aside>
      )}
    </div>
    <footer>
      <p>&copy; {new Date().getFullYear()} Nanobot Bytes</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --background: #ffffff;
    --text: #1a1a1a;
    --primary: #2563eb;
    --border: #e5e5e5;
  }

  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--background);
    color: var(--text);
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  header {
    border-bottom: 1px solid var(--border);
    padding: 1rem 2rem;
  }

  nav {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  nav a {
    text-decoration: none;
    color: var(--text);
    margin-left: 1rem;
  }

  nav a:first-child {
    margin-left: 0;
    font-weight: bold;
  }

  nav a:hover {
    color: var(--primary);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    gap: 2rem;
  }

  main {
    min-width: 0; /* Prevent overflow */
  }

  aside {
    min-width: 0;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 1rem 2rem;
    text-align: center;
  }

  /* Desktop: 2-column layout */
  @media (min-width: 768px) {
    .container {
      grid-template-columns: 1fr 320px;
    }
  }

  /* Mobile: Stack sidebar below content */
  @media (max-width: 767px) {
    .container {
      grid-template-columns: 1fr;
    }

    main {
      order: 1;
    }

    aside {
      order: 2;
    }
  }
</style>
