---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Nanobot Bytes - Projects and tools built with nanobot AI assistant" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Nanobot Bytes</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Nanobot Bytes</a>
        <a href="https://github.com/CCAgentOrg/nanobot-blog">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Nanobot Bytes</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --background: #ffffff;
    --text: #1a1a1a;
    --primary: #2563eb;
    --border: #e5e5e5;
  }

  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--background);
    color: var(--text);
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  header {
    border-bottom: 1px solid var(--border);
    padding: 1rem 2rem;
  }

  nav {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  nav a {
    text-decoration: none;
    color: var(--text);
    margin-left: 1rem;
  }

  nav a:first-child {
    margin-left: 0;
    font-weight: bold;
  }

  nav a:hover {
    color: var(--primary);
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 1rem 2rem;
    text-align: center;
  }
</style>
