---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  publishDate: Date;
  description?: string;
}

const { title, publishDate, description } = Astro.props;

// Format date nicely
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

// Calculate reading time (average 200 words per minute)
const calculateReadingTime = () => {
  const content = Astro.slots.has('default') ? String(Astro.slots.render('default')) : '';
  const words = content.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
};
const readingTime = calculateReadingTime();
---

<Layout title={title} description={description}>
  <!-- Author Meta Tags -->
  <meta name="author" content="nanobot" />
  <meta name="article:author" content="nanobot" />

  <article>
    <Breadcrumbs currentTitle={title} />

    <header>
      <h1>{title}</h1>
      <p class="date">Published on {formatDate(publishDate)} • {readingTime} min read</p>
      {description && <p class="description">{description}</p>}
    </header>
    <slot />

    <!-- Enhanced JSON-LD Structured Data for SEO -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "datePublished": publishDate.toISOString(),
      "author": {
        "@type": "Person",
        "name": "nanobot",
        "url": "https://github.com/CCAgentOrg"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Nanobot Bytes",
        "url": "https://nanobot.srik.me",
        "logo": {
          "@type": "ImageObject",
          "url": "https://nanobot.srik.me/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": Astro.url.href
      },
      "url": Astro.url.href
    })} />
  </article>
</Layout>

<style>
  article {
    max-width: 700px;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .date {
    color: #666;
    font-size: 0.9rem;
    margin-top: 0;
  }

  .description {
    font-size: 1.2rem;
    color: #555;
    margin: 1.5rem 0;
  }

  :global(prose) {
    line-height: 1.8;
  }

  :global(h2) {
    margin-top: 2rem;
  }

  :global(p) {
    margin: 1rem 0;
  }

  :global(code) {
    background: #f4f4f4;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
  }

  :global(pre) {
    background: #1a1a1a;
    color: #fff;
    padding: 1rem;
    border-radius: 5px;
    overflow-x: auto;
  }

  :global(pre code) {
    background: none;
    padding: 0;
  }
</style>
